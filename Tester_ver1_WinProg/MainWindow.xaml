<Window x:Class="Tester_ver1_WinProg.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tester_ver1_WinProg"
        mc:Ignorable="d"
        Title="Tester_ver1_WinProg" Height="380" Width="780">

    <Window.DataContext>
        <local:ViewModel/>
    </Window.DataContext>

    <Grid Margin="0,10,10,0">

        <Grid.RowDefinitions>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="50*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="50*"/>
        </Grid.ColumnDefinitions>

        <!--Stack1-->

        
            <Canvas Grid.Row="0" Background="Lavender" Width="Auto" Height="Auto">
                <ComboBox x:Name="PortCombo" ItemsSource="{Binding PortCombo}" SelectedItem="{Binding PortComboSelectItem}" SelectedIndex="{Binding PortComboSelectIndex}" Canvas.Top="0" Canvas.Left="1" Width="120" Margin="0,0,0,0"/>
            <ComboBox x:Name="BaudCombo" ItemsSource="{Binding BaudCombo}" SelectedItem="{Binding BaudComboSelectItem}" Canvas.Top="Auto" Canvas.Left="Auto" Width="100" Margin="0,0,0,0"/>
                <ComboBox x:Name="ParityCombo" ItemsSource="{Binding ParityCombo}" SelectedItem="{Binding ParityComboSelectItem}" Canvas.Top="40" Canvas.Left="1" Width="90" Margin="0,0,0,0"/>
                <ComboBox x:Name="DataBitsCombo" ItemsSource="{Binding DataBitsCombo}" SelectedItem="{Binding DataBitsComboSelectItem}" Canvas.Top="60" Canvas.Left="1" Width="70" Margin="0,0,0,0"/>
                <ComboBox x:Name="StopBitsCombo" ItemsSource="{Binding StopBitsCombo}" SelectedItem="{Binding StopBitsComboSelectItem}" Canvas.Top="80" Canvas.Left="1" Width="90" Margin="0,0,0,0"/>
                <CheckBox x:Name="RtsCheck" IsChecked="{Binding RtsCheckClick}" Content="RTS" VerticalAlignment="Center" Canvas.Top="100" Canvas.Left="1" Margin="0,0,0,0"/>
                <CheckBox x:Name="DtrCheck" IsChecked="{Binding DtrCheckClick}" Content="DTR" VerticalAlignment="Center" Canvas.Top="120" Canvas.Left="1" Margin="0,0,0,0"/>
                <ComboBox x:Name="HandshakeCombo" ItemsSource="{Binding HandshakeCombo}" SelectedItem="{Binding HandshakeComboSelectItem}" Canvas.Top="140" Canvas.Left="1" Width="130" Margin="0,0,0,0"/>
            </Canvas>




    </Grid>
</Window>
